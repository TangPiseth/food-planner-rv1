# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_here_change_this

# MongoDB Database Configuration
# Replace with your own MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/food-planner?retryWrites=true&w=majority&appName=YourAppName

# Gemini AI API Key for Image Scanner
# Get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Inference API (image scanning)
# Create a read token at https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_token_here
HF_IMAGE_MODEL=nateraw/food101

# Optional: override Hugging Face API endpoint URL
# HF_ENDPOINT_URL=https://api-inference.huggingface.co/models/nateraw/food

# Groq API (text enhancement for ingredients/description)
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MAX_RETRIES=2
# GROQ_RETRY_BASE_MS=500

# Retry settings for Hugging Face transient errors (rate limits, loading, 5xx)
# HF_MAX_RETRIES=3
# HF_RETRY_BASE_MS=500

# Gemini AI model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Comma-separated fallback models used if the primary model fails
# GEMINI_FALLBACK_MODELS=gemini-1.5-flash-8b,gemini-2.0-flash

# Retry settings for transient errors (rate limits, 5xx)
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_BASE_MS=500
