# Backend environment variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food-planner
JWT_SECRET=replace-with-a-strong-random-secret
PORT=3001

# Comma-separated list of allowed frontend origins for CORS
# Example: https://your-frontend-domain.com,http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Frontend build variable
# Use /api when frontend and backend share the same host, or set a full API URL for split hosting.
# VUE_APP_API_BASE_URL=/api
