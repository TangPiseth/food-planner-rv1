# Backend environment variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food-planner
JWT_SECRET=replace-with-a-strong-random-secret
PORT=3001

# Comma-separated list of allowed frontend origins for CORS
# Example: https://eatsbuddy.vercel.app,http://localhost:8080
CORS_ORIGINS=https://eatsbuddy.vercel.app

# Frontend build variable (set in Vercel Project Settings -> Environment Variables)
# Keep /api when frontend and backend are deployed in the same Vercel project.
# VUE_APP_API_BASE_URL=/api
